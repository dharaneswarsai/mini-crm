# This is an EXAMPLE file. It documents the environment variables the
# frontend will need. Copy it to a real `.env` file when you start using it:
#
#   Copy-Item .env.example .env
#
# IMPORTANT: Any variable whose name starts with VITE_ is embedded into the
# browser bundle and is PUBLIC. Never put secrets, passwords, API keys or
# database credentials in a VITE_ variable.
#
# This value documents the future backend API address. It is not used by any
# code yet - the frontend does not call the backend during the scaffold stage.
VITE_API_BASE_URL=http://localhost:5000/api


